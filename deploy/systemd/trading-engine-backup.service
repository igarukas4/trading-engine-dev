[Unit]
Description=Trading Engine PostgreSQL backup and isolated restore verification
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/trading-engine-v0
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/backups/trading-engine
ExecStart=/srv/trading-engine-v0/scripts/backup-and-verify.sh /etc/trading-engine/release.env /var/backups/trading-engine 14
